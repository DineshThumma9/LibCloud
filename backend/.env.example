# Copy to backend/.env and fill in the values.
# Only this file is loaded by the backend; do not create backend/app/.env.

# Strongly recommended. GitHub GraphQL requests are rate-limited without a token.
# Use a fine-grained PAT with read access to the repositories you want to scan.
GITHUB_TOKEN=

# Used only by scripts/pipeline_demo.py. The web UI asks for the username.
GITHUB_USERNAME=your-username

# MongoDB stores the icon cache, repo cache, ops run records, and shares.
# Without a reachable MongoDB, the app falls back to in-memory caches.
MONGO_URI=mongodb://admin:secretpassword@localhost:27017/my_mongodb?authSource=admin
MONGO_DB_NAME=my_mongodb
# Or build the URI from these:
# MONGO_HOST=localhost
# MONGO_PORT=27017
# MONGO_INITDB_ROOT_USERNAME=admin
# MONGO_INITDB_ROOT_PASSWORD=secretpassword

HOST=0.0.0.0
PORT=8000
MAX_CONCURRENT_REPO_SCANS=5
MAX_CONCURRENT_ICON_RESOLVES=12
REQUEST_TIMEOUT_SECONDS=10.0

# Extra allowed CORS origin. Only needed when the frontend is served from a
# different origin than the API. The default frontend uses same-origin paths.
# FRONTEND_URL=https://libcloud.example.com

# Ops dashboard (/ops), protected with HTTP Basic auth.
# Leave either value empty to disable the dashboard (503).
OPS_USER=admin
OPS_PASSWORD=change-me
